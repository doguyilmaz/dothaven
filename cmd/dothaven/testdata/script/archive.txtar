# An archive must be restorable, and owner-only. It is written by dothaven
# itself, so no AppleDouble sidecars and no dependence on the tar binary.

exec dothaven backup --archive -o out --only shell
stdout 'Backup saved — 2 files'
stdout 'dothaven restore backup-'

globpath ARCHIVE out/*.tar.gz
filemode 600 $ARCHIVE

exec dothaven restore --dry-run $ARCHIVE
stdout 'Dry run'
stdout '\.zshrc'

# A directory that is not an archive still works, unchanged.
exec dothaven backup -o plain --only shell
globpath PLAIN plain/backup-*
exec dothaven restore --dry-run $PLAIN
stdout '\.zshrc'

-- .zshrc --
alias ll='ls -la'
export EDITOR=vim
-- .bashrc --
alias gs='git status'
