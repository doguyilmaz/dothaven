# restore dry-run shows the plan without writing
exec dothaven restore Downloads/backup-box-20240101000000 --dry-run
stdout 'Dry run'
stdout '~/.zshrc +new'
stdout '~/.gitconfig +differs from this machine'
! exists .zshrc

# Off a terminal: new files are written, a differing one is kept — and that
# decision is remembered.
exec dothaven restore Downloads/backup-box-20240101000000
stdout 'Restored 1 file'
stdout '1 file left as they are — remembered'
grep 'alias ll' .zshrc
grep 'name = Mine' .gitconfig
exists .local/share/dothaven/applied.json

# Running it again shows everything as done, not as work.
exec dothaven restore Downloads/backup-box-20240101000000
stdout 'already applied|Nothing new to restore'
stdout '1 skipped last time'
stdout '1 already applied'
! stdout 'Restored'

# Editing the restored file after the fact is told apart from a plain conflict.
exec sh -c 'echo "alias mine=1" >> .zshrc'
exec dothaven restore --dry-run Downloads/backup-box-20240101000000
stdout '~/.zshrc +you changed it after restoring'

# --force still overwrites (keeping the old copy aside).
exec dothaven restore --force Downloads/backup-box-20240101000000
stdout 'Restored 2 files'
stdout 'the versions it replaced are in'
grep 'name = Test' .gitconfig

-- Downloads/backup-box-20240101000000/shell/.zshrc --
alias ll='ls -la'
-- Downloads/backup-box-20240101000000/git/.gitconfig --
[user]
	name = Test
-- .gitconfig --
[user]
	name = Mine
