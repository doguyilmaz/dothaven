# scan flags a secret and reports a clean file as such
# A HIGH finding exits 2, so a hook or CI job can gate on it.
! exec dothaven scan secret.txt
stdout '\[HIGH\] GitHub token'
stdout 'Sensitivity report'
stderr 'Exiting 2'
# It says what and where, never the value itself.
! stdout 'ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
stdout 'ghp_••••'


# --no-fail keeps the report and drops the verdict.
exec dothaven scan --no-fail secret.txt
stdout '\[HIGH\] GitHub token'

exec dothaven scan clean.txt
stdout 'No sensitive data found'

# a missing path is an error
! exec dothaven scan nope.txt
stderr 'path not found'

-- .npmrc --
//registry.npmjs.org/:_authToken=npm_abcdefghijklmnopqrstuvwxyz0123456789
-- secret.txt --
token=ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
-- clean.txt --
just some plain text with nothing sensitive

# With no path it scans the config dothaven tracks, wherever it is run from.
mkdir elsewhere
cd elsewhere
! exec dothaven scan
stdout '~/.npmrc'
stdout 'npm'
cd ..
